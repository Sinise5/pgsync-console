# ============================================================================
# PGSync Production — Centralized Environment Configuration (TEMPLATE)
# ============================================================================
# Copy to .env and fill in actual values
# Or use environment-specific files: .env.development, .env.staging, .env.production
# ============================================================================

# ============================================================================
# SHARED (all services use these)
# ============================================================================

# PostgreSQL (source database)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=example_db
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here

# OpenSearch / Elasticsearch (search engine)
OPENSEARCH=true
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=https
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=your_opensearch_password_here
OPENSEARCH_INDEX=laporan
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true

# Elasticsearch aliases (legacy compatibility)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=https
ELASTICSEARCH_USER=admin
ELASTICSEARCH_PASSWORD=your_opensearch_password_here
ELASTICSEARCH_INDEX=laporan
ELASTICSEARCH_USE_SSL=true
ELASTICSEARCH_VERIFY_CERTS=true

# ClickHouse (analytics database)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=pgsync_admin
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
# Optional Docker Admin override; defaults to host.docker.internal for local Docker.
ADMIN_CLICKHOUSE_HOST=host.docker.internal

# Local API configuration; Docker Compose overrides API_HOST for container access.
API_HOST=localhost
API_PORT=3505
LOG_LEVEL=INFO
GENERAL_LOGGING_LEVEL=INFO
CONSOLE_LOGGING_HANDLER_MIN_LEVEL=INFO

# ============================================================================
# PGSYNC ADMIN (backend service) — pgsync-admin/backend
# ============================================================================

# Application runs on the shared API configuration above.

# Database (SQLite local)
DATABASE_URL=sqlite:///pgsync_admin.db
SQLITE_DB_PATH=./pgsync_admin.db

# Encryption (REQUIRED - generate with command below)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_32_character_encryption_key_here_exactly_32_chars

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_recommended
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_chars
# Keep false outside local demos; true displays the configured account on the login page.
DEMO_LOGIN_CREDENTIALS=false

# PGSync Schema
SCHEMA=config/schema.json

# ============================================================================
# SEARCH API (FastAPI service) — search-api/
# ============================================================================

# Host port for Docker (local development uses port 8080).
SEARCH_API_PORT=18080

# ============================================================================
# LAPORAN (legacy reporting) — laporan/
# ============================================================================

# Schema (inherits PG_* and OPENSEARCH_* from SHARED above)
LAPORAN_DB_SCHEMA=public
