FROM python:3.12-slim AS base

LABEL description="PGSync Laporan — base image with test_decoding patch"
LABEL maintainer="QTI Research"

# System deps for psycopg2-binary
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY pyproject.toml /tmp/build/
RUN pip install --no-cache-dir \
        pgsync==7.0.5 \
        opensearch-py==3.0.0 \
        psycopg2-binary==2.9.11

# Apply patches: remove include-xids, skip heartbeat messages
COPY scripts/patch-pgsync-robust.py /tmp/patch-pgsync.py
RUN python3 /tmp/patch-pgsync.py && rm /tmp/patch-pgsync.py

# Verify patch
RUN python3 -c "import pgsync.constants; \
    assert pgsync.constants.PLUGIN == 'test_decoding', 'Patch failed'; \
    print('[OK] PLUGIN =', pgsync.constants.PLUGIN)"

CMD ["/bin/bash"]
